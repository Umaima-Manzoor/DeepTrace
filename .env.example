# ============================================================
# DeepTrace — Environment Configuration Template
# Copy this file to '.env' and insert your personal API keys.
# ============================================================

# 1. Nebius Token Factory (Cloud LLM Inference)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# 2. NVIDIA Nemotron Models
NVIDIA_NANO_MODEL=nvidia/nemotron-nano
NVIDIA_ULTRA_MODEL=nvidia/nemotron-3-ultra

# 3. Tavily AI Search API (Live Grounding)
TAVILY_API_KEY=your_tavily_api_key_here

# 4. Pipeline Settings
APP_ENV=development
MAX_SEARCH_RESULTS=8
CONFIDENCE_THRESHOLD=0.75